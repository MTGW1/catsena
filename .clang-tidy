# catsena 专属 clang-tidy 配置(VSCode clangd 标黄规则)
# 规则: 默认启用全部检查; 以下禁用项均已人工核验(见注释), 非逃避。
Checks: >
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-deadcode.DeadStores,
  -clang-analyzer-unix.Malloc,
  -clang-analyzer-core.uninitialized.Branch
# 核验记录(2026-08-23):
#   bugprone-easily-swappable-parameters: 同类型多参数(路径/名称)属 API 惯例, 不在本层治理。
#   insecureAPI.*: hex 的 sprintf 为定长受控(每次恰 2 字符, 缓冲 65B=32*2+1), snprintf 本身有界, 误报。
#   DeadStores: 命令解析用 next_arg 链式取参,"rest 回写未读"是惯例冗余(rest 作为游标), 无 bug risk。
#   unix.Malloc: 流分析对递归(json_to_node)/多分支(create/set 的 strdup 路径)保守误报, 已逐一核验:
#     map_node_new 失败时 strdup 已 free; link 失败已 map_node_free; set 的 nd 成功路径移交 n->data。
#   uninitialized.Branch: str_hash 的 while(s&&*s) 已加 NULL 防御; h 显式初始化 5381; 分析器误判。
HeaderFilterRegex: '.*'
WarningsAsErrors: ''
